# Public site origin (used for canonical URLs, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://smoke-oclock.shop

# Where the contact / catering lead form delivers (optional; the API route
# logs to the server console when unset so local dev works out of the box).
LEAD_INBOX_EMAIL=management@amritpalace.com

# Telegram delivery for every lead form (order modal, quiz, contact, B2B).
# Create a bot with @BotFather, add it to the group, use the group's chat id.
# Both must also be set in Netlify: Site configuration → Environment variables.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=-1001234567890
